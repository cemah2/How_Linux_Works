#!/bin/bash
# ecrit-commandes : la boutique journalise ses commandes dans un fichier qu'elle garde ouvert.
# Elle ne sait pas rouvrir son journal : si on le renomme, elle continue d'écrire dans l'ancien.
exec >>/var/log/boutique/commandes.log 2>&1
n=5000
trap 'exit 0' TERM INT
while :; do
  n=$((n + 1))
  echo "$(date '+%F %T') commande ${n} validée (client-$((n % 97)), $((n % 9 + 1)) articles)"
  sleep 5 &
  wait $!
done
