#!/bin/bash
# vitrine : site de la boutique en ligne de la Brasserie du Noyau (serveur HTTP minimal).
# Configuration par variables d'environnement : PORT (obligatoire), ADRESSE (127.0.0.1 par défaut).
if [[ $EUID -eq 0 ]]; then
  echo "vitrine : refus de tourner en root (moindre privilège). Lance-moi sous un compte dédié." >&2
  exit 1
fi
if [[ -z "${PORT:-}" ]]; then
  echo "vitrine : variable PORT absente (fichier d’environnement non chargé ?)" >&2
  exit 1
fi
echo "vitrine : écoute sur ${ADRESSE:-127.0.0.1}:${PORT} (utilisateur $(id -un))"
exec python3 -m http.server "$PORT" --bind "${ADRESSE:-127.0.0.1}" --directory /opt/vitrine/www
