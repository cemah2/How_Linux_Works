#!/bin/bash
# journal-capteurs : enregistre les relevés bruts des capteurs dans /var/log/capteurs/brut.log.
# Au premier lancement du lab, il recopie aussi l'historique (256 Mo).
mkdir -p /var/log/capteurs
exec >>/var/log/capteurs/brut.log
if [[ -e /run/hlw-capteurs-historique ]]; then
  dd if=/dev/zero bs=1M count=256 status=none | tr '\0' '#'
  echo
  rm -f /run/hlw-capteurs-historique
fi
trap 'exit 0' TERM INT
n=0
while :; do
  n=$((n + 1))
  echo "$(date '+%F %T') relevé ${n} cuve-1=19,2 cuve-2=18,7 cuve-3=20,1 fermenteur=21,4"
  sleep 2 &
  wait $!
done
